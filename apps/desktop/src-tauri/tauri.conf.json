{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Peep",
	"version": "../package.json",
	"identifier": "app.peep.desktop",
	"build": {
		"frontendDist": "../../web/build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm --prefix ../web run dev",
		"beforeBuildCommand": "npm --prefix ../web run build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["msi", "nsis"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
		"windows": {
			"webviewInstallMode": { "type": "downloadBootstrapper" }
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNkJDNTA2QTE0REU5QzUKUldURjZVMmhCc1ZyT2l0VWk3d2lXVUZ3OHhXQmlNK3owQjVHc2JzcHd2cTQvNkkycDBDcHFoTFoK",
			"endpoints": ["https://github.com/EaeDave/peep/releases/latest/download/latest.json"],
			"windows": { "installMode": "passive" }
		}
	}
}

{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Popup and viewer windows (bundled frontend only)",
	"windows": ["popup", "viewer"],
	"permissions": [
		"core:default",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"allow-open-viewer",
		"allow-update-status",
		"allow-check-update",
		"allow-install-update",
		"allow-start-screen-audio",
		"allow-stop-screen-audio",
		"notification:default"
	]
}

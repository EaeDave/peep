# Copy into Coolify → Environment Variables (never commit real values).
# Generate keys: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long
# Shared invite secret configured in every client. openssl rand -base64 24
INVITE_SECRET=change-me
TURN_DOMAIN=turn.DOMINIO
PUBLIC_LIVEKIT_WS_URL=wss://lk.DOMINIO
CORS_ORIGINS=https://call.DOMINIO
